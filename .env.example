APP_NAME="Shipment Tracking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite needs nothing else (database/database.sqlite is created on migrate).
DB_CONNECTION=sqlite
# PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=shipping
# DB_USERNAME=shipping
# DB_PASSWORD=shipping

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" sends webhooks inside the request; use "database" + `php artisan queue:work` in production.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Where status / date updates come from: manual (default) or fake (demo of the provider port).
TRACKING_PROVIDER=manual

# Plain-text part of the seeded demo tokens (see database/seeders/DatabaseSeeder.php).
DEMO_API_TOKEN=demo-token-garware
DEMO_API_TOKEN_OTHER=demo-token-other

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
